<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>dlss-manager</id>
    <version>$version$</version>
    <title>DLSS Manager</title>
    <authors>gOOvER, Deco (Recol)</authors>
    <projectUrl>https://github.com/gOOvER/DLSS-Manager</projectUrl>
    <projectSourceUrl>https://github.com/gOOvER/DLSS-Manager/tree/main/dlss_manager</projectSourceUrl>
    <bugTrackerUrl>https://github.com/gOOvER/DLSS-Manager/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/gOOvER/DLSS-Manager/blob/main/LICENSE</licenseUrl>
    <docsUrl>https://github.com/gOOvER/DLSS-Manager?tab=readme-ov-file#execution-instructions</docsUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <packageSourceUrl>https://github.com/gOOvER/DLSS-Manager/releases</packageSourceUrl>
    <iconUrl>https://raw.githubusercontent.com/gOOvER/DLSS-Manager/main/dlss_manager/icons/dlss_manager.png</iconUrl>
    <summary>A tool to update DLSS DLLs for various games and launchers.</summary>
    <description>DLSS Manager is a utility that automatically updates DLSS (Deep Learning Super Sampling) DLLs for games across multiple platforms including Steam, EA Play, Ubisoft, Epic Games, GOG, and Battle.net. It simplifies the process of keeping your games up-to-date with the latest DLSS improvements.

**Note: This application requires administrative privileges to run.**

This package installs DLSS Manager via a standard Windows MSI installer.</description>
    <releaseNotes>https://github.com/gOOvER/DLSS-Manager/blob/main/release_notes.txt</releaseNotes>
    <tags>dlss nvidia gaming update-tool admin</tags>
    <dependencies>
      <dependency id="chocolatey-core.extension" version="1.1.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\CHECKSUM" target="tools\CHECKSUM" />
    <file src="tools\chocolateyBeforeModify.ps1" target="tools" />
    <file src="tools\chocolateyInstall.ps1" target="tools" />
    <file src="tools\chocolateyUninstall.ps1" target="tools" />
    <file src="VERIFICATION.TXT" target="tools" />
    <file src="LICENSE" target="tools\LICENSE.txt" />
  </files>
</package>